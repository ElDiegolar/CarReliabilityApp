{
    "version": 2,
    "functions": {
        "pages/api/car-reliability.js": {
            "maxDuration": 60
        },
        "pages/api/car-timeline.js": {
            "maxDuration": 60
        },
        "pages/api/product-reliability.js": {
            "maxDuration": 60
        }
    },
    "env": {
        "NEXT_PUBLIC_SITE_URL": "https://www.lemnaed.com"
    },
    "routes": [
        {
            "src": "/api/car-reliability",
            "dest": "/api/car-reliability.js"
        },
        {
            "src": "/api/car-timeline",
            "dest": "/api/car-timeline.js"
        },
        {
            "src": "/api/product-reliability",
            "dest": "/api/product-reliability.js"
